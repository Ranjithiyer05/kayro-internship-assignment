# Leave everything empty to run in local demo mode (JSON file in .data/).

# Supabase (production). Server-only: never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: real reminder delivery. POSTs {to, text, appointmentId, kind} to this URL.
REMINDER_WEBHOOK_URL=
REMINDER_WEBHOOK_SECRET=
# Protects GET /api/cron/reminders (send as "Authorization: Bearer <secret>").
CRON_SECRET=

# Set to "false" to hide the demo reset endpoint for a real practice.
DEMO_RESET_ENABLED=true
